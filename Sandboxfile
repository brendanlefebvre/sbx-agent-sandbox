FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git tmux ripgrep openssh-client gnupg procps \
      libicu72 \
    && rm -rf /var/lib/apt/lists/*

# GitHub CLI (c-gh; see docs/GH.md) — Debian's own repo doesn't carry `gh`, so
# add GitHub's official apt repo. Ships arm64 packages, so this needs no
# arch-mapping the way the pwsh install below does.
RUN mkdir -p -m 755 /etc/apt/keyrings \
    && curl -fsSL -o /etc/apt/keyrings/githubcli-archive-keyring.gpg \
       https://cli.github.com/packages/githubcli-archive-keyring.gpg \
    && chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && mkdir -p -m 755 /etc/apt/sources.list.d \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
       > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/*

# Node LTS via NodeSource (supports linux/arm64)
RUN curl -fsSL https://deb.nodesource.com/setup_lts.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g @anthropic-ai/claude-code

# PowerShell + Pester, so agents can run this repo's own unit suite inside the
# sandbox (self-hosted sbx development). Microsoft's apt repo is x64-only, so
# install from the GitHub release tarball, arch-mapped (arm64 on both current
# hosts). Version pinned; bump deliberately.
# Checksums are from the release's own hashes.sha256 and MUST be bumped with
# PWSH_VERSION - a stale pair fails the build loudly rather than installing an
# unverified binary. Unlike everything else here, this tarball arrives over plain
# HTTPS with no package-manager signature behind it, so the hash is the only
# integrity check there is. Refresh with:
#   curl -fsSL https://github.com/PowerShell/PowerShell/releases/download/v<ver>/hashes.sha256 | grep linux
#
# PESTER_VERSION is pinned for the same reason and MUST match the version
# .github/workflows/ci.yml installs - bump the two together. Unpinned, the image
# floats to whatever is newest at build time while CI stays fixed, so the two
# can disagree without anyone noticing and "green in the sandbox" stops meaning
# "green in CI". They agreed by luck until this was pinned.
ARG PWSH_VERSION=7.6.4
ARG PWSH_SHA256_ARM64=d4ef2382fa452f2ccbdb48a01adbbce9ed64954872123970c16be6d086d1224b
ARG PWSH_SHA256_X64=4471b5a36bfe86ec7af8525d36bb1cacba0128e7aac22d05cc064bc00e604721
ARG PESTER_VERSION=6.0.1
RUN arch=$(dpkg --print-architecture) \
    && case "$arch" in \
         arm64) pwsh_arch=arm64; pwsh_sha="$PWSH_SHA256_ARM64" ;; \
         amd64) pwsh_arch=x64;   pwsh_sha="$PWSH_SHA256_X64" ;; \
         *) echo "unsupported arch: $arch" && exit 1 ;; \
       esac \
    && curl -fsSL -o /tmp/pwsh.tar.gz \
       "https://github.com/PowerShell/PowerShell/releases/download/v${PWSH_VERSION}/powershell-${PWSH_VERSION}-linux-${pwsh_arch}.tar.gz" \
    && echo "${pwsh_sha}  /tmp/pwsh.tar.gz" | sha256sum -c - \
    && mkdir -p /opt/microsoft/powershell/7 \
    && tar -xzf /tmp/pwsh.tar.gz -C /opt/microsoft/powershell/7 \
    && chmod +x /opt/microsoft/powershell/7/pwsh \
    && ln -s /opt/microsoft/powershell/7/pwsh /usr/bin/pwsh \
    && rm /tmp/pwsh.tar.gz \
    && pwsh -NoProfile -Command "Install-Module Pester -RequiredVersion ${PESTER_VERSION} -Force -Scope AllUsers" \
    && pwsh -NoProfile -Command "(Get-Module -ListAvailable Pester).Version"

# Git config for the mounted Windows repo:
#  - safe.directory '*': wslc Windows bind-mounts present as root:root, but the
#    container runs as non-root agent, so git would refuse the repo with
#    "detected dubious ownership". Trusting all dirs is safe in a throwaway
#    sandbox whose only writable surface is the one mounted repo.
#  - core.autocrlf input: a Windows working tree carries CRLF while the repo
#    stores LF, so a Linux git would show every file as modified. `input`
#    normalizes CRLF->LF when comparing, so a mounted Windows repo reads clean.
#    Repos with their own .gitattributes still override this.
RUN git config --system --add safe.directory '*' \
    && git config --system core.autocrlf input

# Non-root agent; /work is the mount point, owned by agent. .claude is the shared
# auth volume; .claude/projects is a per-repo volume mounted over it — pre-create
# it (agent-owned) so that nested volume mount inherits agent ownership rather
# than defaulting to root.
RUN useradd --create-home --uid 1000 --shell /bin/bash agent \
    && mkdir -p /work /home/agent/.claude/projects \
    && chown -R agent:agent /work /home/agent

# Bake tmux config into the image so every container gets truecolor + working
# modified keys (Shift-Enter). Lives at /home/agent/.tmux.conf (home root, NOT
# under .claude): the .claude auth volume mounts over that subtree and would
# shadow anything nested inside it, losing the config every run.
#  - terminal-features *:RGB — SSH strips COLORTERM, so advertise RGB to any
#    client (the RGB capability comes from this line, not the "256color" name).
#  - extended-keys on + *:extkeys — forward CSI-u sequences instead of
#    collapsing Shift-Enter to a plain Enter.
# Runs as root (USER agent is set later), so chown the file to agent afterward.
RUN printf '%s\n' \
      'set -g  default-terminal "tmux-256color"' \
      'set -as terminal-features ",*:RGB"' \
      'set -s  extended-keys on' \
      'set -as terminal-features ",*:extkeys"' \
      > /home/agent/.tmux.conf \
 && chown agent:agent /home/agent/.tmux.conf

# --ssh support. Under `--ssh`, keys are bind-mounted read-only at
# /home/agent/.ssh-ro as root:root mode 0777 (wslc bind ownership), which ssh
# refuses to use as a private key. The entrypoint copies them into ~/.ssh at
# 0600 at startup (ephemeral, per-container). accept-new admits first-seen host
# keys while still honoring existing known_hosts entries and rejecting a CHANGED
# key for a known host.
RUN printf '\nHost *\n    StrictHostKeyChecking accept-new\n' >> /etc/ssh/ssh_config \
 && printf '%s\n' \
      '#!/bin/bash' \
      'if [ -d /home/agent/.ssh-ro ]; then' \
      '  mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh"' \
      '  cp -r /home/agent/.ssh-ro/. "$HOME/.ssh/" 2>/dev/null || true' \
      '  chmod 600 "$HOME"/.ssh/id_* 2>/dev/null || true' \
      '  [ -f "$HOME/.ssh/known_hosts" ] || touch "$HOME/.ssh/known_hosts"' \
       '  chmod 600 "$HOME/.ssh/known_hosts" 2>/dev/null || true' \
       'fi' \
       'if [ -f /home/agent/.gh-ro/token ]; then' \
       '  gh auth login --with-token < /home/agent/.gh-ro/token' \
       '  gh auth setup-git' \
       'fi' \
       'exec "$@"' \
       > /usr/local/bin/sbx-entrypoint \
 && chmod +x /usr/local/bin/sbx-entrypoint

# In-container sbx client: `sbx sync <op>` (c-heavy, unchanged — see the sync
# section above) and `sbx pr create`/`sbx pr respond` (c-gh, see docs/GH.md).
# Neither is a security boundary in the SSH-forced-command sense; sync's is the
# host-side validator at the far end, and gh's is the PAT's own github.com
# scopes — this script is convenience routing in both cases.
#
# The script is a real file in the repo, not a printf here: it gets an `sh -n`
# syntax gate, unit tests (tests/Client.Tests.ps1), and a shellcheck run in CI
# (.github/workflows/ci.yml) like any other code. chmod separately rather than
# COPY --chmod, since git on Windows drops the exec bit.
COPY sbx-client.sh /usr/local/bin/sbx
RUN chmod +x /usr/local/bin/sbx

# Claude's global config file is normally ~/.claude.json — a sibling of the
# ~/.claude dir, so it would live OUTSIDE the persisted auth volume and be lost
# every run (Claude warns "configuration file not found"). Pointing
# CLAUDE_CONFIG_DIR at the volume relocates .claude.json to
# /home/agent/.claude/.claude.json, inside the volume, so config persists.
ENV CLAUDE_CONFIG_DIR=/home/agent/.claude

# Same problem, same fix, for git: the global config is normally ~/.gitconfig —
# a sibling of the ~/.claude volume mount, so it lives in the container layer and
# every `sbx rebuild` loses it, leaving agents with "Author identity unknown" on
# their first commit. GIT_CONFIG_GLOBAL relocates it INTO the volume, so an
# identity seeded once survives rebuilds (and image rebuilds). Repo-local config
# still wins over it, so a repo that needs a different identity is unaffected.
# Seeding is Set-SbxContainerGitIdentity's job, host-side at container create.
ENV GIT_CONFIG_GLOBAL=/home/agent/.claude/.gitconfig

# UTF-8 locale: debian-slim leaves LANG unset (POSIX), and tmux in a non-UTF-8
# locale renders every non-ASCII glyph as "_" — claude's logo, spinners, and
# status glyphs all degrade (found live in v2 verification; C.utf8 ships with
# glibc, no locales package needed). LC_ALL pins it against overrides.
# DISABLE_AUTOUPDATER: the npm prefix is root-owned so in-container self-update
# can only fail noisily; updates arrive via image rebuild (cattle, not pets).
ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    DISABLE_AUTOUPDATER=1

# Advertise truecolor to TUIs that self-gate on COLORTERM (SSH does not forward
# it). The tmux.conf above makes the pipe carry RGB; this makes apps emit it.
ENV COLORTERM=truecolor

USER agent
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/sbx-entrypoint"]
CMD ["bash"]
